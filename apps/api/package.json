{
  "name": "@senior-club/api",
  "version": "0.1.0",
  "private": true,
  "description": "시니어클럽 production API scaffold",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e:db": "NODE_ENV=test AUTH_DEV_OTP_EXPOSE=true OUTBOX_WORKER_ENABLED=false RUN_DATABASE_E2E=true vitest run src/auth/auth-events.e2e.spec.ts",
    "test:watch": "vitest",
    "seed": "tsx ../../prisma/seed.ts",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.0",
    "firebase-admin": "14.4.0",
    "helmet": "^8.1.0",
    "jose": "6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "ts-loader": "^9.5.4",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.10",
    "supertest": "7.2.2"
  }
}
