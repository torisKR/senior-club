NODE_ENV=development
PORT=4000

# Prisma ORM 7 runtime connection. Use a pooled URL in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/senior_club?schema=public
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=1500
DATABASE_IDLE_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000

# Comma-separated browser origins. Native apps normally send no Origin header.
CORS_ORIGINS=http://localhost:3000

# OTP authentication. The fixed values below are development-only and are
# explicitly rejected when NODE_ENV=production.
AUTH_ACCESS_TOKEN_SECRET=development-only-access-token-secret-change-me
AUTH_OTP_PEPPER=development-only-otp-pepper-change-me
AUTH_OTP_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_OTP_TTL_SECONDS=600
AUTH_DEV_OTP_EXPOSE=false
# Numeric Kakao Developers app ID used to reject access tokens issued to another app.
KAKAO_APP_ID=1539455
CONSENT_DOCUMENT_VERSION=2026-07-01

# Transactional email. Production requires `resend` and a verified sender.
EMAIL_PROVIDER=console
EMAIL_FROM="시니어클럽 <no-reply@localhost>"
# RESEND_API_KEY=replace-with-platform-secret

SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-platform-secret
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+821012345678

# Firebase Cloud Messaging. Production requires `firebase`. Use base64 to
# preserve the service-account JSON in the platform secret store.
PUSH_PROVIDER=disabled
# FCM_SERVICE_ACCOUNT_JSON_BASE64=replace-with-platform-secret

# PostgreSQL outbox and account-deletion workers
OUTBOX_POLL_INTERVAL_MS=5000
ACCOUNT_DELETION_POLL_INTERVAL_MS=300000
OUTBOX_WORKER_ENABLED=true
