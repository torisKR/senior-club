# Public build-time values only. Never place API keys or service-account JSON
# in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Public native platform key restricted by Android package and signing key hash.
KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key

# Public AdMob identifiers. Development builds ignore these and use Google test ads.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-5744832247312120~3966489068
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-5744832247312120/1610421489
