{
  "name": "mobile",
  "packageManager": "pnpm@9.14.2",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@react-native-kakao/core": "2.4.6",
    "@react-native-kakao/user": "2.4.6",
    "expo": "~57.0.7",
    "expo-build-properties": "^57.0.9",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "eas-build-post-install": "node ./scripts/validate-android-manifest.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:play": "node ./scripts/validate-play-assets.mjs",
    "validate:manifest": "node ./scripts/validate-android-manifest.mjs",
    "validate:screenshots": "node ./scripts/validate-store-screenshots.mjs",
    "validate:screenshots:release": "node ./scripts/validate-play-screenshots.mjs",
    "validate:store": "node ./scripts/validate-play-assets.mjs && node ./scripts/validate-android-manifest.mjs && node ./scripts/validate-store-screenshots.mjs",
    "test:release-validators": "node --test ./scripts/release-api-url.test.mjs ./scripts/validate-release-endpoints.test.mjs ./scripts/release-android-preflight.test.mjs ./scripts/extract-eas-build-id.test.mjs",
    "validate:play-internal-workflow": "node --test ./scripts/android-play-internal-workflow.test.mjs",
    "validate:play-production-workflow": "node --test ./scripts/android-play-production-workflow.test.mjs",
    "release:android:preflight": "node ./scripts/release-android-preflight.mjs"
  },
  "private": true
}
