{
  "name": "mobile",
  "packageManager": "pnpm@9.14.2",
  "main": "expo-router/entry",
  "version": "0.1.5",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.27",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-iap": "4.7.2",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "16.5.0",
    "react-native-purchases": "10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "scripts": {
    "eas-build-post-install": "node ./scripts/validate-android-manifest.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:play": "node ./scripts/validate-play-assets.mjs",
    "validate:manifest": "node ./scripts/validate-android-manifest.mjs",
    "validate:manifest:merged": "node ./scripts/validate-merged-android-manifest.mjs",
    "test:manifest:merged": "node --test ./scripts/validate-merged-android-manifest.test.mjs",
    "validate:screenshots:release": "node ./scripts/validate-play-screenshots.mjs",
    "validate:store": "node ./scripts/validate-play-assets.mjs && node ./scripts/validate-android-manifest.mjs && node ./scripts/validate-play-screenshots.mjs",
    "test:release-validators": "node --test ./scripts/release-api-url.test.mjs ./scripts/validate-release-endpoints.test.mjs ./scripts/release-android-preflight.test.mjs ./scripts/extract-eas-build-id.test.mjs ./scripts/direct-android-release.test.mjs && python3 scripts/direct_play_release_test.py && python3 scripts/kakao_key_hashes_test.py",
    "validate:play-internal-workflow": "node --test ./scripts/android-play-internal-workflow.test.mjs",
    "validate:play-production-workflow": "node --test ./scripts/android-play-production-workflow.test.mjs",
    "release:android:preflight": "node ./scripts/release-android-preflight.mjs"
  },
  "private": true
}
