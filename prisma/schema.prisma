generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  LEADER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  EMAIL
  KAKAO
  NAVER
  GOOGLE
}

enum SessionClientType {
  WEB
  ANDROID
  IOS
}

enum VerificationPurpose {
  LOGIN
  EMAIL_VERIFICATION
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AccountDeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum ConsentDocumentType {
  TERMS
  PRIVACY
  MARKETING_EMAIL
  MARKETING_PUSH
}

enum ClubStatus {
  ACTIVE
  ARCHIVED
}

enum ClubMemberRole {
  MEMBER
  MODERATOR
  LEADER
}

enum ClubMemberStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
  BANNED
}

enum EventDifficulty {
  EASY
  MODERATE
  HARD
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
  CANCELED
}

enum ApprovalMode {
  AUTO
  MANUAL
}

enum EventMemberStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum AttendanceStatus {
  NOT_CHECKED
  ATTENDED
  NO_SHOW
}

enum PostType {
  GENERAL
  NOTICE
  PHOTO
}

enum ContentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum AttachmentType {
  IMAGE
  FILE
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  NOTICE
}

enum NotificationType {
  NEW_EVENT
  COMMENT
  REPLY
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  EVENT_REMINDER
  REVIEW_REQUEST
  SYSTEM
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
  FAILED
}

enum NewsletterRecipientStatus {
  PENDING
  SENT
  FAILED
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  REVIEW
  CHAT_MESSAGE
}

enum ReportReason {
  SPAM
  ABUSE
  HARASSMENT
  MISINFORMATION
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model User {
  id                    String       @id @default(cuid())
  email                 String?      @unique
  phoneNumber           String?      @unique @map("phone_number")
  name                  String
  birthYear             Int?         @map("birth_year")
  region                 String?
  gender                 Gender?
  avatarUrl              String?      @map("avatar_url")
  bio                    String?      @db.VarChar(300)
  role                   UserRole     @default(MEMBER)
  status                 UserStatus   @default(ACTIVE)
  emailVerifiedAt        DateTime?     @map("email_verified_at")
  phoneVerifiedAt        DateTime?     @map("phone_verified_at")
  onboardingCompletedAt DateTime?     @map("onboarding_completed_at")
  termsAgreedAt          DateTime?     @map("terms_agreed_at")
  marketingAgreedAt      DateTime?     @map("marketing_agreed_at")
  lastLoginAt            DateTime?     @map("last_login_at")
  deletionRequestedAt    DateTime?     @map("deletion_requested_at")
  anonymizedAt           DateTime?     @map("anonymized_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  authIdentities       AuthIdentity[]
  authSessions         AuthSession[]
  emailVerifications  EmailVerification[]
  phoneVerifications  PhoneVerification[]
  devicePushTokens     DevicePushToken[]
  notificationPreference NotificationPreference?
  consentRecords       ConsentRecord[]
  idempotencyRecords   IdempotencyRecord[]
  deletionRequests     AccountDeletionRequest[]
  interests            UserInterest[]
  clubMemberships      ClubMember[]
  ledClubs             Club[]                 @relation("ClubLeader")
  createdEvents        Event[]                @relation("EventCreator")
  eventMemberships     EventMember[]          @relation("EventParticipant")
  reviewedApplications EventMember[]          @relation("ApplicationReviewer")
  attendanceChecks     EventMember[]          @relation("AttendanceChecker")
  posts                Post[]
  comments             Comment[]
  reviews              Review[]
  chatMemberships      ChatRoomMember[]
  chatMessages         ChatMessage[]
  notifications        Notification[]         @relation("NotificationRecipient")
  notificationActions  Notification[]         @relation("NotificationActor")
  authoredNewsletters  Newsletter[]           @relation("NewsletterAuthor")
  newsletterDeliveries NewsletterRecipient[]
  filedReports         Report[]               @relation("ReportReporter")
  reportsAgainst       Report[]               @relation("ReportedUser")
  resolvedReports      Report[]               @relation("ReportResolver")
  auditLogs            AdminAuditLog[]         @relation("AuditActor")
  requestedFriendships Friendship[]           @relation("FriendshipRequester")
  receivedFriendships  Friendship[]           @relation("FriendshipAddressee")
  initiatedBlocks        UserBlock[]               @relation("UserBlockInitiator")
  receivedBlocks         UserBlock[]               @relation("UserBlockTarget")
  applicationTransitions EventMemberTransition[]   @relation("EventMemberTransitionActor")

  @@index([status, createdAt])
  @@index([region])
  @@map("users")
}

model AuthIdentity {
  id                String       @id @default(cuid())
  userId            String       @map("user_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  passwordHash      String?      @map("password_hash")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  refreshTokenHash String            @unique @map("refresh_token_hash")
  clientType       SessionClientType @map("client_type")
  deviceName       String?           @map("device_name") @db.VarChar(120)
  userAgent        String?           @map("user_agent") @db.VarChar(500)
  ipHash           String?           @map("ip_hash") @db.VarChar(128)
  expiresAt        DateTime          @map("expires_at")
  lastUsedAt       DateTime          @default(now()) @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerification {
  id         String              @id @default(cuid())
  userId     String?             @map("user_id")
  email      String
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, consumedAt, expiresAt])
  @@index([userId, createdAt])
  @@map("email_verifications")
}

model PhoneVerification {
  id          String              @id @default(cuid())
  userId      String?             @map("user_id")
  phoneNumber String              @map("phone_number")
  purpose     VerificationPurpose
  codeHash    String              @map("code_hash")
  attempts    Int                 @default(0)
  expiresAt   DateTime            @map("expires_at")
  consumedAt  DateTime?           @map("consumed_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, purpose, consumedAt, expiresAt])
  @@index([userId, createdAt])
  @@map("phone_verifications")
}

model DevicePushToken {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  token      String         @unique @db.Text
  platform   DevicePlatform
  deviceId   String?        @map("device_id") @db.VarChar(160)
  appVersion String?        @map("app_version") @db.VarChar(40)
  enabledAt  DateTime       @default(now()) @map("enabled_at")
  disabledAt DateTime?      @map("disabled_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, disabledAt])
  @@map("device_push_tokens")
}

model NotificationPreference {
  userId              String   @id @map("user_id")
  pushEnabled         Boolean  @default(false) @map("push_enabled")
  pushEventUpdates    Boolean  @default(true) @map("push_event_updates")
  pushChatMessages    Boolean  @default(true) @map("push_chat_messages")
  emailEventUpdates   Boolean  @default(true) @map("email_event_updates")
  emailNewsletter     Boolean  @default(false) @map("email_newsletter")
  quietHoursStart     String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd       String?  @map("quiet_hours_end") @db.VarChar(5)
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ConsentRecord {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  documentType ConsentDocumentType @map("document_type")
  version      String              @db.VarChar(40)
  granted      Boolean
  source       String              @db.VarChar(40)
  recordedAt   DateTime            @default(now()) @map("recorded_at")
  withdrawnAt  DateTime?           @map("withdrawn_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId, recordedAt])
  @@map("consent_records")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  route          String   @db.VarChar(160)
  key            String   @db.VarChar(160)
  requestHash    String   @map("request_hash") @db.VarChar(128)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AccountDeletionRequest {
  id             String                  @id @default(cuid())
  userId         String                  @map("user_id")
  status         AccountDeletionStatus   @default(REQUESTED)
  reason         String?                 @db.VarChar(500)
  requestedAt    DateTime                @default(now()) @map("requested_at")
  scheduledFor   DateTime                @map("scheduled_for")
  completedAt    DateTime?               @map("completed_at")
  failureCode    String?                 @map("failure_code") @db.VarChar(100)
  updatedAt      DateTime                @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, requestedAt])
  @@map("account_deletion_requests")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  type          String       @db.VarChar(120)
  aggregateType String       @map("aggregate_type") @db.VarChar(80)
  aggregateId   String       @map("aggregate_id") @db.VarChar(120)
  dedupKey      String       @unique @map("dedup_key") @db.VarChar(200)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8) @map("max_attempts")
  availableAt   DateTime     @default(now()) @map("available_at")
  lockedAt      DateTime?    @map("locked_at")
  lockedBy      String?      @map("locked_by") @db.VarChar(120)
  processedAt   DateTime?    @map("processed_at")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model Interest {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  icon      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserInterest[]
  clubs Club[]

  @@index([isActive, sortOrder])
  @@map("interests")
}

model UserInterest {
  userId     String   @map("user_id")
  interestId String   @map("interest_id")
  selectedAt DateTime @default(now()) @map("selected_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interests")
}

model Club {
  id              String     @id @default(cuid())
  interestId      String     @map("interest_id")
  leaderId        String     @map("leader_id")
  slug            String     @unique
  title           String
  description     String     @db.Text
  coverImageUrl   String?    @map("cover_image_url")
  region          String?
  status          ClubStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  interest Interest     @relation(fields: [interestId], references: [id], onDelete: Restrict)
  leader   User         @relation("ClubLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members  ClubMember[]
  events   Event[]
  posts    Post[]

  @@index([interestId, status])
  @@index([leaderId])
  @@index([region, status])
  @@index([status, createdAt, id])
  @@map("clubs")
}

model ClubMember {
  id        String           @id @default(cuid())
  clubId    String           @map("club_id")
  userId    String           @map("user_id")
  role      ClubMemberRole   @default(MEMBER)
  status    ClubMemberStatus @default(PENDING)
  joinedAt  DateTime?        @map("joined_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, status, role])
  @@map("club_members")
}

model Event {
  id                   String          @id @default(cuid())
  clubId               String          @map("club_id")
  creatorId            String          @map("creator_id")
  title                String
  description          String          @db.Text
  coverImageUrl        String?         @map("cover_image_url")
  locationName         String          @map("location_name")
  address              String
  mapUrl               String?         @map("map_url")
  latitude             Decimal?        @db.Decimal(9, 6)
  longitude            Decimal?        @db.Decimal(9, 6)
  startAt              DateTime        @map("start_at")
  endAt                DateTime?       @map("end_at")
  registrationDeadline DateTime?       @map("registration_deadline")
  capacity             Int
  price                 Int             @default(0)
  currency              String          @default("KRW") @db.Char(3)
  difficulty           EventDifficulty
  supplies             String?         @db.Text
  approvalMode         ApprovalMode     @default(MANUAL) @map("approval_mode")
  status               EventStatus      @default(DRAFT)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  club         Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  creator      User          @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  participants EventMember[]
  reviews      Review[]
  chatRoom     ChatRoom?

  @@index([clubId, status, startAt])
  @@index([creatorId])
  @@index([status, startAt])
  @@index([status, updatedAt, id])
  @@index([locationName, startAt])
  @@map("events")
}

model EventMember {
  id             String            @id @default(cuid())
  eventId        String            @map("event_id")
  userId         String            @map("user_id")
  status         EventMemberStatus @default(PENDING)
  attendance     AttendanceStatus  @default(NOT_CHECKED)
  reviewedById   String?           @map("reviewed_by_id")
  checkedInById  String?           @map("checked_in_by_id")
  appliedAt      DateTime          @default(now()) @map("applied_at")
  decidedAt      DateTime?         @map("decided_at")
  canceledAt     DateTime?         @map("canceled_at")
  checkedInAt    DateTime?         @map("checked_in_at")
  note           String?           @db.VarChar(500)
  updatedAt      DateTime          @updatedAt @map("updated_at")

  event       Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user        User  @relation("EventParticipant", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  checkedInBy User? @relation("AttendanceChecker", fields: [checkedInById], references: [id], onDelete: SetNull)
  transitions EventMemberTransition[]

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status, attendance])
  @@map("event_members")
}

model EventMemberTransition {
  id             String             @id @default(cuid())
  eventMemberId  String             @map("event_member_id")
  actorId        String?            @map("actor_id")
  fromStatus     EventMemberStatus? @map("from_status")
  toStatus       EventMemberStatus? @map("to_status")
  fromAttendance AttendanceStatus?  @map("from_attendance")
  toAttendance   AttendanceStatus?  @map("to_attendance")
  reason         String?            @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")

  eventMember EventMember @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)
  actor       User?       @relation("EventMemberTransitionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventMemberId, createdAt])
  @@index([actorId, createdAt])
  @@map("event_member_transitions")
}

model Post {
  id        String        @id @default(cuid())
  clubId    String        @map("club_id")
  userId    String        @map("user_id")
  type      PostType      @default(GENERAL)
  status    ContentStatus @default(PUBLISHED)
  title     String
  content   String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  club        Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  author      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  comments    Comment[]
  attachments PostAttachment[]
  reports     Report[]

  @@index([clubId, status, createdAt, id])
  @@index([userId, createdAt])
  @@map("posts")
}

model PostAttachment {
  id        String         @id @default(cuid())
  postId    String         @map("post_id")
  type      AttachmentType
  url       String
  fileName  String?        @map("file_name")
  mimeType  String?        @map("mime_type")
  sizeBytes Int?           @map("size_bytes")
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("post_attachments")
}

model Comment {
  id        String        @id @default(cuid())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  parentId  String?       @map("parent_id")
  status    ContentStatus @default(PUBLISHED)
  content   String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  post    Post      @relation(fields: [postId], references: [id], onDelete: Restrict)
  author  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies Comment[] @relation("CommentReplies")
  reports Report[]

  @@index([postId, status, createdAt, id])
  @@index([userId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Review {
  id        String        @id @default(cuid())
  eventId   String        @map("event_id")
  userId    String        @map("user_id")
  rating    Int
  content   String        @db.Text
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  author      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  attachments ReviewAttachment[]
  reports     Report[]

  @@unique([eventId, userId])
  @@index([eventId, status, createdAt, id])
  @@index([userId, createdAt])
  @@map("reviews")
}

model ReviewAttachment {
  id        String         @id @default(cuid())
  reviewId  String         @map("review_id")
  type      AttachmentType @default(IMAGE)
  url       String
  fileName  String?        @map("file_name")
  mimeType  String?        @map("mime_type")
  sizeBytes Int?           @map("size_bytes")
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
  @@map("review_attachments")
}

model ChatRoom {
  id        String   @id @default(cuid())
  eventId   String   @unique @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  members  ChatRoomMember[]
  messages ChatMessage[]

  @@index([updatedAt, id])
  @@map("chat_rooms")
}

model ChatRoomMember {
  roomId     String    @map("room_id")
  userId     String    @map("user_id")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  leftAt     DateTime? @map("left_at")
  mutedAt    DateTime? @map("muted_at")
  lastReadAt DateTime? @map("last_read_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
  @@index([userId, leftAt])
  @@map("chat_room_members")
}

model ChatMessage {
  id              String          @id @default(cuid())
  roomId          String          @map("room_id")
  userId          String          @map("user_id")
  replyToId       String?         @map("reply_to_id")
  clientMessageId String?         @map("client_message_id") @db.VarChar(100)
  type            ChatMessageType @default(TEXT)
  message         String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  editedAt        DateTime?       @map("edited_at")
  deletedAt       DateTime?       @map("deleted_at")

  room        ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  replyTo     ChatMessage?    @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]   @relation("MessageReplies")
  attachments ChatAttachment[]
  reports     Report[]

  @@unique([roomId, userId, clientMessageId])
  @@index([roomId, createdAt, id])
  @@index([userId, createdAt])
  @@index([replyToId])
  @@map("chat_messages")
}

model ChatAttachment {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  type      AttachmentType
  url       String
  fileName  String?        @map("file_name")
  mimeType  String?        @map("mime_type")
  sizeBytes Int?           @map("size_bytes")
  createdAt DateTime       @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("chat_attachments")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String           @map("recipient_id")
  actorId     String?          @map("actor_id")
  type        NotificationType
  title       String
  body        String
  link        String?
  payload     Json?
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model Newsletter {
  id             String           @id @default(cuid())
  authorId       String           @map("author_id")
  subject        String
  content        String           @db.Text
  audienceFilter Json?            @map("audience_filter")
  status         NewsletterStatus @default(DRAFT)
  scheduledAt    DateTime?        @map("scheduled_at")
  sentAt         DateTime?        @map("sent_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  author     User                  @relation("NewsletterAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  recipients NewsletterRecipient[]

  @@index([status, scheduledAt])
  @@map("newsletters")
}

model NewsletterRecipient {
  newsletterId String                    @map("newsletter_id")
  userId       String                    @map("user_id")
  status       NewsletterRecipientStatus @default(PENDING)
  sentAt       DateTime?                 @map("sent_at")
  failureCode  String?                   @map("failure_code")

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([newsletterId, userId])
  @@index([userId, status])
  @@map("newsletter_recipients")
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String           @map("reporter_id")
  resolverId     String?          @map("resolver_id")
  targetType     ReportTargetType @map("target_type")
  reportedUserId String?          @map("reported_user_id")
  postId         String?          @map("post_id")
  commentId      String?          @map("comment_id")
  reviewId       String?          @map("review_id")
  chatMessageId  String?          @map("chat_message_id")
  reason         ReportReason
  detail         String?          @db.VarChar(1000)
  status         ReportStatus     @default(OPEN)
  resolutionNote String?          @map("resolution_note") @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at")
  resolvedAt     DateTime?        @map("resolved_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver     User?    @relation("ReportResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  reportedUser User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  review       Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  chatMessage  ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([reporterId, createdAt])
  @@index([reportedUserId])
  @@index([postId])
  @@index([commentId])
  @@index([reviewId])
  @@index([chatMessageId])
  @@map("reports")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  pairKey     String           @unique @map("pair_key")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("UserBlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@map("user_blocks")
}
