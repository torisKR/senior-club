# Copy this file to `.env` only for local development. Vercel, ECS,
# GitHub Actions, and EAS must use their encrypted environment stores.
# Never commit production credentials.

# Shared runtime
NODE_ENV=development
PORT=4000

# Web and API origins
# NEXT_PUBLIC_APP_URL is intentionally public and is used for canonical/SEO URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional GA4 web measurement. Only initializes on senior.toris.kr after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server-only. Do not rename this to NEXT_PUBLIC_* or expose API credentials here.
SENIOR_CLUB_API_BASE_URL=http://127.0.0.1:4000
# Comma-separated browser origins; native apps normally send no Origin header.
CORS_ORIGINS=http://localhost:3000

# Expo values are embedded in the Android bundle and must never contain secrets.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL / Prisma
# Production uses encrypted Amazon RDS PostgreSQL; inject credentials as a secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/senior_club?schema=public
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=1500
DATABASE_IDLE_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000

# Kakao-only login and app session signing.
# Kakao numeric application ID, required in production. OAuth client keys are separate.
KAKAO_APP_ID=1539455
# Legacy OTP credentials remain required for stored outbox data; OTP login is disabled.
# These fixed values are local-development examples and are rejected in production.
AUTH_ACCESS_TOKEN_SECRET=development-only-access-token-secret-change-me
AUTH_OTP_PEPPER=development-only-otp-pepper-change-me
AUTH_OTP_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_OTP_TTL_SECONDS=600
AUTH_DEV_OTP_EXPOSE=false
CONSENT_DOCUMENT_VERSION=2026-07-01

# Enable resend only after configuring and testing a verified sender.
EMAIL_PROVIDER=disabled
EMAIL_FROM="시니어클럽 <no-reply@localhost>"
# RESEND_API_KEY=replace-with-platform-secret

# This legacy notification channel does not enable Firebase Phone Auth.
SMS_PROVIDER=disabled
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-platform-secret
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+821012345678

# Optional push uses its own API-only credential. Disabled channels do not send.
PUSH_PROVIDER=disabled
# FCM_SERVICE_ACCOUNT_JSON_BASE64=replace-with-platform-secret

# Optional profile phone verification: Firebase Authentication Phone provider,
# KR SMS region policy and billing must be configured separately.
# API uses Firebase Admin Application Default Credentials (ADC), independently of FCM.
# FIREBASE_PROJECT_ID=clubsenior-app
# Optional Android app review login; only this provisioned Firebase UID is accepted.
# AUTH_REVIEWER_FIREBASE_UID=replace-with-dedicated-review-user-uid
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# Never use Android google-services.json or a developer CLI token as server credentials.

# PostgreSQL outbox worker
OUTBOX_POLL_INTERVAL_MS=5000
ACCOUNT_DELETION_POLL_INTERVAL_MS=300000
OUTBOX_WORKER_ENABLED=true

# Reserved for later integrations. The current API does not read these values.
REDIS_URL=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SENTRY_DSN=

# Kakao OAuth (web server only)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Native Kakao client key is public app configuration, not the web REST key.
# KAKAO_NATIVE_APP_KEY=your-32-character-native-client-key
# GOOGLE_SERVICES_JSON=/secure/path/android-client-google-services.json
