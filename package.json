{
  "name": "senior-club",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "api:dev": "pnpm --dir apps/api dev",
    "api:build": "pnpm --dir apps/api build",
    "api:test": "pnpm --dir apps/api test",
    "api:typecheck": "pnpm --dir apps/api typecheck",
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "mobile:lint": "pnpm --dir apps/mobile lint",
    "mobile:doctor": "pnpm --dir apps/mobile exec expo-doctor",
    "mobile:test:release-validators": "pnpm --dir apps/mobile test:release-validators",
    "release:android:preflight": "pnpm --dir apps/mobile release:android:preflight",
    "build:sites": "opennextjs-cloudflare build && node scripts/stage-sites-worker.mjs",
    "preview:sites": "opennextjs-cloudflare preview",
    "deploy:sites": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-pg": "7.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "jsdom": "26.1.0",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "^4.142.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@>=1 <2": "1.19.15",
      "fast-uri@>=3 <4": "3.1.8",
      "valibot@>=1 <2": "1.4.2",
      "postcss@>=8 <9": "8.5.23",
      "hono@>=4 <5": "4.13.7",
      "js-yaml@>=4 <5": "4.3.2",
      "browserslist@>=4 <5": "4.28.7",
      "mysql2@>=3 <4": "3.23.1",
      "qs@>=6 <7": "6.16.0",
      "baseline-browser-mapping@>=2 <3": "2.11.0",
      "sharp@>=0.35.0 <0.36.0": "0.35.4",
      "multer@>=2 <3": "2.4.0",
      "undici@>=7 <8": "7.29.1",
      "engine.io@>=6 <7": "6.6.10",
      "@grpc/grpc-js@>=1 <2": "1.14.5",
      "brace-expansion@>=1 <2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "brace-expansion@>=5 <6": "5.0.12",
      "@prisma/config@7.8.0>deepmerge-ts": "8.0.0",
      "xcode@3.0.1>uuid": "11.1.1",
      "gaxios@6.7.1>uuid": "11.1.1",
      "teeny-request@9.0.0>uuid": "11.1.1",
      "query-string@7.1.3>decode-uri-component": "0.5.0"
    },
    "patchedDependencies": {
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  }
}
